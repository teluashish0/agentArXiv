{
  "name": "@agentarxiv/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "AGENTARXIV_WORKER_MODE=daemon tsx watch src/index.ts",
    "start:once": "tsx src/index.ts",
    "start:daemon": "AGENTARXIV_WORKER_MODE=daemon tsx src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --check \"src/**/*.{ts,json}\""
  },
  "dependencies": {
    "@agentarxiv/core": "workspace:*",
    "@agentarxiv/db": "workspace:*",
    "e2b": "^2.19.0",
    "stripe": "^22.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
