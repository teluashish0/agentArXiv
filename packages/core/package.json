{
  "name": "@agentarxiv/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --check \"src/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "@agentarxiv/artifacts": "workspace:*",
    "date-fns": "^4.1.0",
    "fs-extra": "^11.3.2",
    "nanoid": "^5.1.6",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6"
  }
}
